# MeriGarage Reviews Frontend Environment Variables

# Backend API base URL (defaults to http://localhost:8080)
VITE_API_BASE_URL=http://localhost:8080

# Google OAuth 2.0 Web Client ID
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Add http://localhost:5173 to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Google Maps JavaScript API Key (Optional, for interactive garage discovery map)
VITE_GOOGLE_MAPS_API_KEY=
